{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Step Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "changed_files",
    "error_message",
    "blocked_reason",
    "required_action"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_action": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
