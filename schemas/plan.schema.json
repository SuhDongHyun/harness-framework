{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "goal",
    "status",
    "steps",
    "final_acceptance_commands"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "depends_on",
          "objective",
          "read_files",
          "allowed_paths",
          "acceptance_commands",
          "forbidden_changes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^step-[0-9]{2}$"
            }
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "read_files": {
            "$ref": "#/$defs/paths"
          },
          "allowed_paths": {
            "$ref": "#/$defs/paths"
          },
          "acceptance_commands": {
            "$ref": "#/$defs/nonEmptyCommands"
          },
          "forbidden_changes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "final_acceptance_commands": {
      "$ref": "#/$defs/commands"
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonEmptyCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
